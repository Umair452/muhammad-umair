{% comment %}
  Featured Collection with Quick View Popup
  --------------------------------------------------
  - Pick a collection in the section settings.
  - Products render in a responsive grid.
  - Clicking the "+" button on a product image opens a popup
    with the product's variants/options and an Add to Cart form,
    powered by Shopify's AJAX Storefront API (no page reload).
{% endcomment %}

{% assign fcp_collection = collections[section.settings.collection] %}

<div class="fcp-section" style="--fcp-bg: {{ section.settings.background_color }}; --fcp-card-bg: {{ section.settings.card_background }};">
  <div class="fcp-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="fcp-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if fcp_collection == blank or fcp_collection.products.size == 0 %}
      <div class="fcp-empty">
        {% if fcp_collection == blank %}
          Select a collection in the section settings to display products here.
        {% else %}
          The collection "{{ fcp_collection.title }}" has no products yet.
        {% endif %}
      </div>
    {% else %}
      <div class="fcp-grid" style="--fcp-columns: {{ section.settings.columns_desktop }}; --fcp-columns-mobile: {{ section.settings.columns_mobile }};">
        {% for product in fcp_collection.products limit: section.settings.products_to_show %}
          <div class="fcp-item">
            <div class="fcp-image-wrap">
              {% if product.featured_image %}
                <img
                  class="fcp-image"
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  srcset="{{ product.featured_image | image_url: width: 450 }} 450w, {{ product.featured_image | image_url: width: 900 }} 900w"
                  sizes="(max-width: 749px) 50vw, 33vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="900"
                  height="{{ 900 | divided_by: product.featured_image.aspect_ratio }}"
                >
              {% else %}
                <div class="fcp-image-placeholder">{{ 'image' | placeholder_svg_tag: 'fcp-placeholder-svg' }}</div>
              {% endif %}

              <button
                type="button"
                class="fcp-plus-btn"
                data-fcp-open
                data-product-handle="{{ product.handle }}"
                aria-label="Quick view {{ product.title | escape }}"
                aria-haspopup="dialog"
              >
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <line x1="10" y1="3" x2="10" y2="17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  <line x1="3" y1="10" x2="17" y2="10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </div>

            {% if section.settings.show_title_price %}
              <div class="fcp-item-meta">
                <p class="fcp-item-title">{{ product.title }}</p>
                <p class="fcp-item-price">{{ product.price | money }}</p>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<!-- Quick view / Add to cart popup -->
<div class="fcp-modal" id="fcp-modal" aria-hidden="true">
  <div class="fcp-modal-overlay" data-fcp-close tabindex="-1"></div>
  <div class="fcp-modal-content" role="dialog" aria-modal="true" aria-labelledby="fcp-modal-title">
    <button type="button" class="fcp-modal-close" data-fcp-close aria-label="Close">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <line x1="4" y1="4" x2="16" y2="16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="16" y1="4" x2="4" y2="16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="fcp-modal-body" id="fcp-modal-body">
      <div class="fcp-modal-loading">Loading product…</div>
    </div>
  </div>
</div>

<style>
  .fcp-section {
    background: var(--fcp-bg, #ececec);
    padding: 48px 24px;
  }

  .fcp-wrap {
    max-width: 1100px;
    margin: 0 auto;
    background: var(--fcp-card-bg, #ffffff);
    padding: 40px;
  }

  .fcp-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 26px;
    letter-spacing: 0.01em;
    margin: 0 0 24px;
    color: #1a1a1a;
  }

  .fcp-empty {
    padding: 40px 0;
    color: #6b6b6b;
    font-size: 14px;
  }

  .fcp-grid {
    display: grid;
    grid-template-columns: repeat(var(--fcp-columns, 3), 1fr);
    gap: 24px;
  }

  .fcp-item-meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
    font-size: 13px;
    color: #1a1a1a;
  }

  .fcp-item-title {
    margin: 0;
    font-weight: 500;
  }

  .fcp-item-price {
    margin: 0;
    color: #6b6b6b;
  }

  .fcp-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f2f2f2;
  }

  .fcp-image,
  .fcp-image-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fcp-plus-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1a1a1a;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
    transition: transform 0.15s ease, background 0.15s ease;
    padding: 0;
  }

  .fcp-plus-btn svg { width: 16px; height: 16px; }

  .fcp-plus-btn:hover,
  .fcp-plus-btn:focus-visible {
    transform: scale(1.1);
    background: #ffffff;
  }

  .fcp-plus-btn:focus-visible {
    outline: 2px solid #1a1a1a;
    outline-offset: 2px;
  }

  /* Modal */
  .fcp-modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
  }

  .fcp-modal[aria-hidden="false"] {
    display: block;
  }

  .fcp-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 20, 0.55);
  }

  .fcp-modal-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
    width: calc(100% - 32px);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    margin: 32px auto;
    background: #fff;
    padding: 32px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .fcp-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fcp-modal-close svg { width: 18px; height: 18px; }

  .fcp-modal-loading {
    padding: 60px 0;
    text-align: center;
    color: #6b6b6b;
    font-size: 14px;
  }

  .fcp-pd {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .fcp-pd-media img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: #f2f2f2;
  }

  .fcp-pd-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 22px;
    margin: 0 0 8px;
    color: #1a1a1a;
  }

  .fcp-pd-price {
    font-size: 16px;
    color: #1a1a1a;
    margin: 0 0 20px;
  }

  .fcp-pd-price .fcp-compare {
    text-decoration: line-through;
    color: #9a9a9a;
    margin-right: 8px;
    font-size: 14px;
  }

  .fcp-pd-option {
    margin-bottom: 18px;
  }

  .fcp-pd-option-label {
    display: block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6b6b6b;
    margin-bottom: 8px;
  }

  .fcp-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fcp-swatch {
    border: 1px solid #d4d4d4;
    background: #fff;
    padding: 8px 14px;
    font-size: 13px;
    cursor: pointer;
    color: #1a1a1a;
  }

  .fcp-swatch[aria-pressed="true"] {
    border-color: #1a1a1a;
    background: #1a1a1a;
    color: #fff;
  }

  .fcp-swatch:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .fcp-pd-qty-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .fcp-qty {
    display: flex;
    align-items: center;
    border: 1px solid #d4d4d4;
  }

  .fcp-qty button {
    width: 34px;
    height: 34px;
    border: none;
    background: #fff;
    cursor: pointer;
    font-size: 16px;
    color: #1a1a1a;
  }

  .fcp-qty input {
    width: 40px;
    text-align: center;
    border: none;
    border-left: 1px solid #d4d4d4;
    border-right: 1px solid #d4d4d4;
    height: 34px;
    font-size: 14px;
    -moz-appearance: textfield;
  }

  .fcp-add-btn {
    width: 100%;
    margin-top: 20px;
    padding: 14px 20px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    font-size: 14px;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .fcp-add-btn:hover { background: #333; }

  .fcp-add-btn:disabled {
    background: #c9c9c9;
    cursor: not-allowed;
  }

  .fcp-pd-status {
    margin-top: 12px;
    font-size: 13px;
    min-height: 18px;
  }

  .fcp-pd-status[data-state="success"] { color: #1c6b3c; }
  .fcp-pd-status[data-state="error"] { color: #b23a3a; }

  @media (max-width: 749px) {
    .fcp-wrap { padding: 24px 16px; }
    .fcp-grid { grid-template-columns: repeat(var(--fcp-columns-mobile, 2), 1fr); gap: 12px; }
    .fcp-pd { grid-template-columns: 1fr; }
    .fcp-modal-content { padding: 24px; margin: 16px auto; }
  }
</style>

<script>
(function () {
  var sectionId = {{ section.id | json }};
  var modal = document.getElementById('fcp-modal');
  var modalBody = document.getElementById('fcp-modal-body');
  var lastFocused = null;
  var productCache = {};

  function moneyFormat(cents) {
    if (window.Shopify && typeof window.Shopify.formatMoney === 'function' && window.theme && window.theme.moneyFormat) {
      return window.Shopify.formatMoney(cents, window.theme.moneyFormat);
    }
    return '$' + (cents / 100).toFixed(2);
  }

  function openModal() {
    lastFocused = document.activeElement;
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    var closeBtn = modal.querySelector('.fcp-modal-close');
    if (closeBtn) closeBtn.focus();
    document.addEventListener('keydown', onKeydown);
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeydown);
    modalBody.innerHTML = '<div class="fcp-modal-loading">Loading product…</div>';
    if (lastFocused) lastFocused.focus();
  }

  function onKeydown(e) {
    if (e.key === 'Escape') closeModal();
  }

  modal.addEventListener('click', function (e) {
    if (e.target.hasAttribute('data-fcp-close')) closeModal();
  });

  document.addEventListener('click', function (e) {
    var trigger = e.target.closest('[data-fcp-open]');
    if (!trigger) return;
    var handle = trigger.getAttribute('data-product-handle');
    openModal();
    loadProduct(handle);
  });

  function loadProduct(handle) {
    if (productCache[handle]) {
      renderProduct(productCache[handle]);
      return;
    }
    fetch('/products/' + handle + '.js')
      .then(function (res) {
        if (!res.ok) throw new Error('Product request failed');
        return res.json();
      })
      .then(function (product) {
        productCache[handle] = product;
        renderProduct(product);
      })
      .catch(function () {
        modalBody.innerHTML = '<div class="fcp-modal-loading">Sorry, this product could not be loaded.</div>';
      });
  }

  function renderProduct(product) {
    var selectedOptions = product.options.map(function (opt, i) {
      return product.variants[0].options[i];
    });

    function findVariant() {
      return product.variants.find(function (v) {
        return v.options.every(function (val, i) { return val === selectedOptions[i]; });
      });
    }

    function optionValuesFor(index) {
      var values = [];
      product.variants.forEach(function (v) {
        if (values.indexOf(v.options[index]) === -1) values.push(v.options[index]);
      });
      return values;
    }

    var optionsHtml = product.options.map(function (optionName, index) {
      if (product.options.length === 1 && optionName.toLowerCase() === 'title') return '';
      var swatches = optionValuesFor(index).map(function (value) {
        var pressed = selectedOptions[index] === value;
        var testOptions = selectedOptions.slice();
        testOptions[index] = value;
        var matching = product.variants.find(function (v) {
          return v.options.every(function (val, i) { return val === testOptions[i]; });
        });
        var available = matching ? matching.available : false;
        return '<button type="button" class="fcp-swatch" data-option-index="' + index + '" data-value="' + value.replace(/"/g, '&quot;') + '" aria-pressed="' + pressed + '"' + (available ? '' : ' disabled') + '>' + value + '</button>';
      }).join('');
      return '<div class="fcp-pd-option"><span class="fcp-pd-option-label">' + optionName + '</span><div class="fcp-swatches" data-option-group="' + index + '">' + swatches + '</div></div>';
    }).join('');

    var variant = findVariant();

    var priceHtml = variant
      ? (variant.compare_at_price && variant.compare_at_price > variant.price
          ? '<span class="fcp-compare">' + moneyFormat(variant.compare_at_price) + '</span>' + moneyFormat(variant.price)
          : moneyFormat(variant.price))
      : '';

    modalBody.innerHTML =
      '<div class="fcp-pd">' +
        '<div class="fcp-pd-media"><img src="' + (product.featured_image ? product.featured_image.replace(/(\.[a-zA-Z]{3,4})(\?.*)?$/, '_800x$1$2') : '') + '" alt="' + product.title.replace(/"/g, '&quot;') + '"></div>' +
        '<div class="fcp-pd-info">' +
          '<h2 class="fcp-pd-title" id="fcp-modal-title">' + product.title + '</h2>' +
          '<p class="fcp-pd-price" data-price>' + priceHtml + '</p>' +
          optionsHtml +
          '<div class="fcp-pd-qty-row">' +
            '<div class="fcp-qty">' +
              '<button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>' +
              '<input type="number" min="1" value="1" data-qty-input aria-label="Quantity">' +
              '<button type="button" data-qty-plus aria-label="Increase quantity">+</button>' +
            '</div>' +
          '</div>' +
          '<button type="button" class="fcp-add-btn" data-add-to-cart' + (variant && variant.available ? '' : ' disabled') + '>' +
            (variant && variant.available ? 'Add to cart' : 'Sold out') +
          '</button>' +
          '<p class="fcp-pd-status" data-status role="status"></p>' +
        '</div>' +
      '</div>';

    modalBody.addEventListener('click', function handler(e) {
      var swatch = e.target.closest('.fcp-swatch');
      if (swatch) {
        var idx = parseInt(swatch.getAttribute('data-option-index'), 10);
        selectedOptions[idx] = swatch.getAttribute('data-value');
        renderProduct(product);
        return;
      }
      if (e.target.closest('[data-qty-minus]')) {
        var input = modalBody.querySelector('[data-qty-input]');
        input.value = Math.max(1, parseInt(input.value || '1', 10) - 1);
        return;
      }
      if (e.target.closest('[data-qty-plus]')) {
        var input2 = modalBody.querySelector('[data-qty-input]');
        input2.value = parseInt(input2.value || '1', 10) + 1;
        return;
      }
      if (e.target.closest('[data-add-to-cart]')) {
        addToCart();
        return;
      }
    }, { once: false });

    function addToCart() {
      var currentVariant = findVariant();
      if (!currentVariant || !currentVariant.available) return;
      var qtyInput = modalBody.querySelector('[data-qty-input]');
      var qty = parseInt(qtyInput.value || '1', 10);
      var btn = modalBody.querySelector('[data-add-to-cart]');
      var status = modalBody.querySelector('[data-status]');

      btn.disabled = true;
      btn.textContent = 'Adding…';
      status.removeAttribute('data-state');
      status.textContent = '';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: currentVariant.id, quantity: qty }] })
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (result) {
          if (!result.ok) throw new Error(result.data && result.data.description || 'Could not add to cart');
          btn.disabled = false;
          btn.textContent = 'Add to cart';
          status.setAttribute('data-state', 'success');
          status.textContent = 'Added to cart.';
          document.dispatchEvent(new CustomEvent('cart:refresh'));
        })
        .catch(function (err) {
          btn.disabled = false;
          btn.textContent = 'Add to cart';
          status.setAttribute('data-state', 'error');
          status.textContent = err.message || 'Something went wrong. Please try again.';
        });
    }
  }
})();
</script>

{% schema %}
{
  "name": "Featured collection popup",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_title_price",
      "label": "Show product title and price under image",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ececec"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Content background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Featured collection popup"
    }
  ]
}
{% endschema %}