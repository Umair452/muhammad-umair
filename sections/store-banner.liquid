<div class="store-banner">
  <div class="store-banner__hamburger" role="button" aria-label="Menu">
    {%- if section.settings.hamburger_icon != blank -%}
      {{ section.settings.hamburger_icon | image_url: width: 80 | image_tag: width: 32, height: 32, alt: 'Menu', class: 'store-banner__hamburger-icon' }}
    {%- else -%}
      <svg class="store-banner__hamburger-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3 6H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M3 12H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    {%- endif -%}
  </div>

  <div class="store-banner__heading">
    <h1 class="store-banner__store-name">{{ section.settings.store_name | default: shop.name }}</h1>
  </div>

  <div class="store-banner__slogan">
    <p>{{ section.settings.slogan }}</p>
  </div>

  <div class="store-banner__button">
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="store-banner__btn">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Store Banner",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "My Store"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan",
      "default": "Your store's slogan goes here"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "hamburger_icon",
      "label": "Hamburger icon (mobile)",
      "info": "Optional — falls back to a default SVG icon if left empty."
    }
  ],
  "presets": [
    { "name": "Store Banner" }
  ]
}
{% endschema %}