<div class="hero-parent-div">
<div class="hero-section hero-section--{{ section.settings.size }}">
  <div class="hero-section__media">
    {%- if section.settings.background_image != blank -%}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000',
          class: 'hero-section__image'
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-section__image hero-section__image--placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero-section__card hero-section__card--desktop-{{ section.settings.desktop_position }} hero-section__card--mobile-{{ section.settings.mobile_position }}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="hero-section__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="hero-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hero-section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hero-section__button">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
  
</div>
<div class="hero-bottom-text">
  <h3>{{ section.settings.hero_bottom_text }}</h3>
  </div>
</div>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Section size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    { "type": "header", "content": "Text" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hero heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a subheading here"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
        "type": "text",
        "id": "hero_bottom_text",
        "label": "Bottom Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    { "type": "header", "content": "Desktop card position" },
    {
      "type": "select",
      "id": "desktop_position",
      "label": "Position",
      "options": [
        { "value": "top-left", "label": "Left, top" },
        { "value": "center-left", "label": "Left, center" },
        { "value": "bottom-left", "label": "Left, bottom" },
        { "value": "top-center", "label": "Middle, top" },
        { "value": "center-center", "label": "Middle, center" },
        { "value": "bottom-center", "label": "Middle, bottom" },
        { "value": "top-right", "label": "Right, top" },
        { "value": "center-right", "label": "Right, center" },
        { "value": "bottom-right", "label": "Right, bottom" }
      ],
      "default": "center-left"
    },
    { "type": "header", "content": "Mobile layout" },
    {
      "type": "select",
      "id": "mobile_position",
      "label": "Content layout",
      "options": [
        { "value": "split", "label": "Text top, button bottom" },
        { "value": "top", "label": "Together - top" },
        { "value": "center", "label": "Together - middle" },
        { "value": "bottom", "label": "Together - bottom" }
      ],
      "default": "split"
    }
  ],
  "presets": [
    { "name": "Hero Section" }
  ]
}
{% endschema %}